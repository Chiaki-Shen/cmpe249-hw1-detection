## S6: link existing KITTI copy (Oct 16)
ls ~/apollo/data/kitti/data_object_image_2/training/
# -> calib image_2 label_2 (7481 images, 7481 labels)
mkdir -p ~/cmpe249-hw/datasets/kitti/training
ln -s ~/apollo/data/kitti/data_object_image_2/training/image_2 ~/cmpe249-hw/datasets/kitti/training/image_2
ln -s ~/apollo/data/kitti/data_object_image_2/training/label_2 ~/cmpe249-hw/datasets/kitti/training/label_2
cd ~/cmpe249-hw/DeepDataMiningLearning
python -m DeepDataMiningLearning.ngdet.datasets --name kitti --root ~/cmpe249-hw/datasets/kitti --max-images 3
# -> auto split (seed 42): train 5984 / val 1497; evaluation uses train split

## S7: smoke test, 50 imgs/dataset, thr 0.3 (Oct 16)
python -m DeepDataMiningLearning.ngdet.run_eval \
  --models torchvision:fasterrcnn_resnet50_fpn_v2 yolo:yolo11x.pt hf_detr:PekingU/rtdetr_r50vd \
  --datasets coco kitti \
  --roots coco=$HOME/cmpe249-hw/datasets/coco/val2017 kitti=$HOME/cmpe249-hw/datasets/kitti \
