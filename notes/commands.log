  --max-images 50 --score-thr 0.3 --device cuda --video --video-max 20 \
  --out-dir $HOME/cmpe249-hw/runs/smoke

## S8: full runs, thr 0.3 (Oct 17)
time python -m DeepDataMiningLearning.ngdet.run_eval \
  --models yolo:yolo11x.pt --datasets coco kitti \
  --roots coco=$HOME/cmpe249-hw/datasets/coco/val2017 kitti=$HOME/cmpe249-hw/datasets/kitti \
  --coco-ann $HOME/cmpe249-hw/datasets/coco/annotations/instances_val2017.json \
  --max-images 0 --score-thr 0.3 --device cuda --video --video-max 40 \
  --out-dir $HOME/cmpe249-hw/runs/full_yolo11x \
  2>&1 | grep --line-buffered -v "'half' is deprecated" | tee $HOME/cmpe249-hw/runs/full_yolo11x.log
for M in torchvision:fasterrcnn_resnet50_fpn_v2 hf_detr:PekingU/rtdetr_r50vd; do
  NAME=$(echo $M | cut -d: -f1)
  ( time python -m DeepDataMiningLearning.ngdet.run_eval --models $M --datasets coco kitti \
      --roots coco=$HOME/cmpe249-hw/datasets/coco/val2017 kitti=$HOME/cmpe249-hw/datasets/kitti \
      --coco-ann $HOME/cmpe249-hw/datasets/coco/annotations/instances_val2017.json \
      --max-images 0 --score-thr 0.3 --device cuda --video --video-max 40 \
      --out-dir $HOME/cmpe249-hw/runs/full_$NAME ) 2>&1 | tee $HOME/cmpe249-hw/runs/full_$NAME.log
done
# -> mAP COCO/KITTI: FRCNN 0.481/0.234 (17m25s), YOLO11x 0.492/0.229 (6m17s), RT-DETR 0.492/0.239 (9m16s)

# S8 input-resolution inspection
grep -n "predict(" -A 2 ~/cmpe249-hw/DeepDataMiningLearning/DeepDataMiningLearning/ngdet/detectors/yolo.py
cat ~/.cache/huggingface/hub/models--PekingU--rtdetr_r50vd/snapshots/*/preprocessor_config.json
python -c "import torchvision; m=torchvision.models.detection.fasterrcnn_resnet50_fpn_v2(); print(m.transform)"
# -> YOLO imgsz 640 letterbox (KITTI ~640x224, shape kept); RT-DETR 640x640 stretched, do_normalize=false;
#    FRCNN min 800 / max 1333 (KITTI -> 1333x402, shape kept)

## S9: threshold experiment, thr 0.001, all 3 models (Oct 17)
time python -m DeepDataMiningLearning.ngdet.run_eval \
  --models yolo:yolo11x.pt --datasets coco kitti \
  --roots coco=$HOME/cmpe249-hw/datasets/coco/val2017 kitti=$HOME/cmpe249-hw/datasets/kitti \
  --coco-ann $HOME/cmpe249-hw/datasets/coco/annotations/instances_val2017.json \
  --max-images 0 --score-thr 0.001 --device cuda \
  --out-dir $HOME/cmpe249-hw/runs/thr001_yolo11x \
  2>&1 | grep --line-buffered -v "'half' is deprecated" | tee $HOME/cmpe249-hw/runs/thr001_yolo11x.log
for M in torchvision:fasterrcnn_resnet50_fpn_v2 hf_detr:PekingU/rtdetr_r50vd; do
  NAME=$(echo $M | cut -d: -f1)
  ( time python -m DeepDataMiningLearning.ngdet.run_eval --models $M --datasets coco kitti \
      --roots coco=$HOME/cmpe249-hw/datasets/coco/val2017 kitti=$HOME/cmpe249-hw/datasets/kitti \
      --coco-ann $HOME/cmpe249-hw/datasets/coco/annotations/instances_val2017.json \
      --max-images 0 --score-thr 0.001 --device cuda \
      --out-dir $HOME/cmpe249-hw/runs/thr001_$NAME ) 2>&1 | tee $HOME/cmpe249-hw/runs/thr001_$NAME.log
done
# -> mAP COCO/KITTI: FRCNN 0.492/0.236, YOLO11x 0.558/0.239, RT-DETR 0.517/0.243
#    note: torchvision FRCNN keeps its internal box_score_thresh=0.05 regardless of --score-thr

## S10: latency + GPU memory, batch 1, KITTI image 000008.png (1242x375), warmup 5, iters 50 (Oct 17)
gcc --version
# -> gcc 11.4.0 (needed for torch.compile)
nvidia-smi --query-gpu=memory.used --format=csv
# -> idle baseline 314 MiB (Apollo container stopped)
cd ~/cmpe249-hw/DeepDataMiningLearning
IMG=$HOME/cmpe249-hw/datasets/kitti/training/image_2/000008.png
for M in torchvision:fasterrcnn_resnet50_fpn_v2 yolo:yolo11x.pt hf_detr:PekingU/rtdetr_r50vd; do
  NAME=$(echo $M | cut -d: -f1)
  nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits -lms 200 > $HOME/cmpe249-hw/runs/mem_$NAME.txt &
  SMI=$!
  python -m DeepDataMiningLearning.ngdet.latency --models $M \
    --accel fp32 fp16 compile --iters 50 --image $IMG \
    --out-dir $HOME/cmpe249-hw/runs/latency_$NAME \
    2>&1 | grep --line-buffered -v "'half' is deprecated" | tee $HOME/cmpe249-hw/runs/latency_$NAME.log
  kill $SMI
  echo ">>> $M peak GPU memory (MiB): $(sort -n $HOME/cmpe249-hw/runs/mem_$NAME.txt | tail -1)"
done
# -> FRCNN  fp32 72.9ms/13.7FPS  fp16 41.7ms/24.0FPS (x1.75)  compile 89.0ms (x0.82, graph break in torchvision poolers.py:104)  peak 1613 MiB
# -> YOLO11x fp32 19.7ms/50.7FPS fp16 18.6ms/53.7FPS (x1.06)  compile not supported  peak 967 MiB
# -> RT-DETR fp32 41.9ms/23.9FPS fp16 30.8ms/32.4FPS (x1.36)  compile 37.3ms (x1.12)  peak 947 MiB

## S11: combined report, thr 0.001 (Oct 17)
mkdir -p ~/cmpe249-hw/runs/combined_thr001
cd ~/cmpe249-hw/runs
python -c "
import json
m = []
for d in ['thr001_torchvision', 'thr001_yolo11x', 'thr001_hf_detr']:
    m += json.load(open(d + '/metrics.json'))
json.dump(m, open('combined_thr001/metrics.json', 'w'), indent=2)
print(len(m), 'runs merged')
"
cd ~/cmpe249-hw/DeepDataMiningLearning
python -m DeepDataMiningLearning.ngdet.report --metrics $HOME/cmpe249-hw/runs/combined_thr001/metrics.json
# -> gap COCO-KITTI: FRCNN +0.256, YOLO11x +0.319, RT-DETR +0.274

